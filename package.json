{
  "name": "aptos-gas-estimator",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "description": "Estimate when an Aptos account will run out of gas",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.22.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
